# ShelbyNet address that receives dataset license payments.
NEXT_PUBLIC_MARKETPLACE_TREASURY_ADDRESS=0xYOUR_SHELBYNET_ADDRESS

# Shelby/Geomi client key. Required to discover shared marketplace listings.
# Create a frontend/client key at https://developers.shelby.xyz/.
NEXT_PUBLIC_SHELBY_API_KEY=

# Server-only Vercel Blob credential. Never expose this as a NEXT_PUBLIC value.
BLOB_READ_WRITE_TOKEN=
